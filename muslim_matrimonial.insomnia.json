    {
      "_id": "req_login",
      "_type": "request",
      "parentId": "fld_auth",
      "modified": 1754697600000,
      "created": 1754697600000,
      "name": "Login",
      "description": "On success, the After-Response Script below saves access_token/refresh_token into the Base Environment automatically.",
      "method": "POST",
      "url": "{{ _.base_url }}/api/auth/login",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.email }}\",\n  \"password\": \"{{ _.password }}\"\n}"
      },
      "parameters": [],
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "authentication": { "type": "none" },
      "afterResponseScript": "const response = insomnia.response;\nif (response.status !== 200) {\n  console.log('Login failed with status ' + response.status);\n} else {\n  const body = response.json();\n  insomnia.environment.set('access_token', body.access);\n  insomnia.environment.set('refresh_token', body.refresh);\n  console.log('Saved access_token and refresh_token to the Base Environment.');\n}",
      "metaSortKey": -700,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_refresh_token",
      "_type": "request",
      "parentId": "fld_auth",
      "modified": 1754697600000,
      "created": 1754697600000,
      "name": "Refresh Token",
      "description": "SIMPLE_JWT.ROTATE_REFRESH_TOKENS is off, so the response only carries a new access token. The After-Response Script still updates refresh_token too, in case rotation is enabled later.",
      "method": "POST",
      "url": "{{ _.base_url }}/api/auth/refresh-token",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"refresh\": \"{{ _.refresh_token }}\"\n}"
      },
      "parameters": [],
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "authentication": { "type": "none" },
      "afterResponseScript": "const response = insomnia.response;\nif (response.status !== 200) {\n  console.log('Refresh failed with status ' + response.status);\n} else {\n  const body = response.json();\n  if (body.access) {\n    insomnia.environment.set('access_token', body.access);\n  }\n  if (body.refresh) {\n    insomnia.environment.set('refresh_token', body.refresh);\n  }\n  console.log('Updated tokens in the Base Environment.');\n}",
      "metaSortKey": -600,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global"
    },
    {
      "_id": "req_logout",
      "_type": "request",
      "parentId": "fld_auth",
      "modified": 1754697600000,
      "created": 1754697600000,
      "name": "Logout",
      "description": "Blacklists the refresh token.",
      "method": "POST",
      "url": "{{ _.base_url }}/api/auth/logout",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"refresh\": \"{{ _.refresh_token }}\"\n}"
      },
      "parameters": [],
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "authentication": { "type": "bearer", "token": "{{ _.access_token }}", "prefix": "" },
      "afterResponseScript": "const response = insomnia.response;\nif (response.status === 200) {\n  insomnia.environment.set('access_token', '');\n  insomnia.environment.set('refresh_token', '');\n  console.log('Cleared tokens from the Base Environment.');\n}",
      "metaSortKey": -500,
      "isPrivate": false,
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
