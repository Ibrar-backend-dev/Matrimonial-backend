DJANGO_SECRET_KEY=replace-this-in-production

DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

TIME_ZONE=Asia/Karachi

CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
# Set these when Postgres sits behind PgBouncer in transaction-pooling mode
# (every real deployment). DB_CONN_MAX_AGE=0 leaves connection lifetime to
# the pooler; DISABLE_SERVER_SIDE_CURSORS must stay true under transaction
# pooling. Leave both at their defaults for local dev against a bare Postgres.
DB_CONN_MAX_AGE=0
DB_DISABLE_SERVER_SIDE_CURSORS=true

# Master on/off switches. Turn both off for a Redis-less/worker-less
# smoke-test deploy (e.g. handing the API to a frontend dev before Celery/
# Redis are provisioned): cache + channel layer fall back to per-process
# in-memory backends and Celery tasks run inline instead of being queued.
# CELERY_ENABLED is forced off automatically whenever REDIS_ENABLED=false
# (no broker to talk to without Redis). Leave both true for any real
# deployment -- the in-memory fallbacks aren't shared across processes.
REDIS_ENABLED=false
CELERY_ENABLED=false
# Local-dev fallback: a single Redis container, separated by logical db
# number. In any real deployment, set REDIS_CACHE_URL and REDIS_CELERY_URL to
# two SEPARATE Redis instances (eviction policy is instance-wide, not
# per-db -- the Celery broker must never share an instance's eviction policy
# with the cache). REDIS_CHANNELS_URL can stay on the cache instance until
# WebSocket volume justifies its own instance. Ignored when REDIS_ENABLED=false.
REDIS_HOST=
REDIS_PORT=
REDIS_CACHE_URL=
REDIS_CELERY_URL=
REDIS_CHANNELS_URL=

# Local/test convenience ONLY -- config/settings/production.py raises at
# startup if this is still true (unless CELERY_ENABLED=false), since eager
# mode runs Celery tasks synchronously inside the request cycle and silently
# breaks latency targets.
CELERY_TASK_ALWAYS_EAGER=true

EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Muslim Matrimonial <no-reply@muslimmatrimonial.local>

# Media: private S3 bucket + CloudFront. There is no public serving path --
# every photo is only reachable via a short-lived signed URL. AWS credentials
# themselves come from the standard AWS SDK chain (env vars/IAM role), not
# from Django settings -- only bucket/region/CloudFront config lives here.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_QUARANTINE_PREFIX=quarantine
# Required in production (no public bucket access exists) -- leave blank in
# local dev to fall back to a signed S3 GET URL instead of CloudFront.
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
MEDIA_UPLOAD_MAX_BYTES=2097152
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_SIGNED_URL_TTL_SECONDS=300
MEDIA_QUARANTINE_EXPIRY_HOURS=24
